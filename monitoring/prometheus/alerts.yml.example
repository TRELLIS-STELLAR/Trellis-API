# Example Prometheus alerting rules aligned with the Grafana
# `application-overview` dashboard SLO panels.
#
# Drop this file into the directory configured under `rule_files` in your
# prometheus.yml.

groups:
  - name: trellis-api-slo
    interval: 30s
    rules:
      - alert: HighErrorRate
        expr: |
          100 * sum(rate(trellis_errors_total[5m]))
            / clamp_min(sum(rate(trellis_http_requests_total[5m])), 0.001) > 1
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: 'Trellis API error rate above 1%'
          description: 'Error rate has been above 1% for the last 5 minutes (current: {{ $value | printf "%.2f" }}%).'

      - alert: HighP95Latency
        expr: |
          histogram_quantile(0.95,
            sum by (le) (rate(trellis_http_request_duration_seconds_bucket[5m]))
          ) > 1
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: 'Trellis API p95 latency above 1s'
          description: 'p95 latency has been above 1s for the last 10 minutes (current: {{ $value | printf "%.2f" }}s).'

      - alert: HighEventLoopLag
        expr: trellis_nodejs_eventloop_lag_seconds > 0.5
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: 'Node.js event loop lag detected'
          description: 'Event loop lag has been above 0.5s for 5 minutes (current: {{ $value | printf "%.2f" }}s).'

      - alert: HighMemoryUsage
        expr: trellis_process_resident_memory_bytes > 1073741824
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: 'Process RSS above 1 GiB'
          description: 'Resident memory has been above 1 GiB for 10 minutes (current: {{ $value | humanize1024 }}B).'

      - alert: PerformanceRegression
        expr: max(trellis_performance_regressions_total) > 5
        for: 1m
        labels:
          severity: info
        annotations:
          summary: 'Performance regressions detected'
          description: '{{ $value }} performance regressions have been recorded in the last 24h.'

  - name: trellis-api-resources
    interval: 30s
    rules:
      - alert: HighSystemCpuUsage
        expr: trellis_system_cpu_usage_percent > 85
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: 'System CPU usage above 85%'
          description: 'System CPU usage has been above 85% for 5 minutes (current: {{ $value | printf "%.1f" }}%).'

      - alert: HighSystemMemoryUsage
        expr: trellis_system_memory_usage_percent > 90
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: 'System memory usage above 90%'
          description: 'System memory usage has been above 90% for 5 minutes (current: {{ $value | printf "%.1f" }}%).'

      - alert: HighDiskUsage
        expr: trellis_system_disk_usage_percent > 90
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: 'Disk usage above 90%'
          description: 'Disk usage on {{ $labels.mount }} has been above 90% for 5 minutes (current: {{ $value | printf "%.1f" }}%).'

      - alert: MonitoringAlertFiring
        expr: sum(trellis_alerts_active) > 0
        for: 1m
        labels:
          severity: info
        annotations:
          summary: 'In-process monitoring alerts are firing'
          description: '{{ $value }} in-process alert rule(s) are currently firing.'
