{
  "id": "stripe-malformed-signature",
  "category": "invalid-signature",
  "target": "payments.webhook-signature",
  "description": "Stripe-Signature header with an empty v1= token, so no usable signature candidate can be extracted.",
  "input": {
    "provider": "stripe",
    "secrets": { "STRIPE_WEBHOOK_SECRET": "corpus_stripe_secret" },
    "rawBody": "{\"id\":\"evt_malformed_sig\",\"type\":\"payment_intent.succeeded\"}",
    "headers": {
      "stripe-signature": "t=1800000000,v1="
    },
    "nowSeconds": 1800000000
  },
  "expected": { "ok": false, "reason": "malformed_signature", "status": 400 }
}
